{
 "stages": [
  {
   "$lookup": {
    "from": "channelIntelligence",
    "localField": "channelId",
    "foreignField": "channelId",
    "as": "_ci"
   }
  },
  {
   "$addFields": {
    "_ciExcluded": {
     "$let": {
      "vars": {
       "ci": {
        "$ifNull": [
         {
          "$arrayElemAt": [
           "$_ci",
           0
          ]
         },
         {}
        ]
       }
      },
      "in": {
       "$let": {
        "vars": {
         "attempted": {
          "$convert": {
           "input": "$$ci.outcomes.attempted",
           "to": "double",
           "onError": 0,
           "onNull": 0
          }
         },
         "deleted": {
          "$convert": {
           "input": "$$ci.outcomes.deleted",
           "to": "double",
           "onError": 0,
           "onNull": 0
          }
         },
         "consecutiveErrors": {
          "$convert": {
           "input": "$$ci.safety.consecutiveErrors",
           "to": "double",
           "onError": 0,
           "onNull": 0
          }
         }
        },
        "in": {
         "$or": [
          {
           "$eq": [
            "$$ci.safety.status",
            "blocked"
           ]
          },
          {
           "$gte": [
            "$$consecutiveErrors",
            3
           ]
          },
          {
           "$and": [
            {
             "$gte": [
              "$$attempted",
              10
             ]
            },
            {
             "$gt": [
              {
               "$cond": [
                {
                 "$gt": [
                  "$$attempted",
                  0
                 ]
                },
                {
                 "$divide": [
                  "$$deleted",
                  "$$attempted"
                 ]
                },
                0
               ]
              },
              0.5
             ]
            }
           ]
          }
         ]
        }
       }
      }
     }
    }
   }
  },
  {
   "$match": {
    "_ciExcluded": {
     "$ne": true
    }
   }
  },
  {
   "$addFields": {
    "sortScore": {
     "$let": {
      "vars": {
       "ci": {
        "$ifNull": [
         {
          "$arrayElemAt": [
           "$_ci",
           0
          ]
         },
         {}
        ]
       }
      },
      "in": {
       "$let": {
        "vars": {
         "attempted": {
          "$convert": {
           "input": "$$ci.outcomes.attempted",
           "to": "double",
           "onError": 0,
           "onNull": 0
          }
         },
         "credited": {
          "$convert": {
           "input": "$$ci.DMs.credited",
           "to": "double",
           "onError": 0,
           "onNull": 0
          }
         },
         "survived": {
          "$convert": {
           "input": "$$ci.outcomes.survived",
           "to": "double",
           "onError": 0,
           "onNull": 0
          }
         }
        },
        "in": {
         "$let": {
          "vars": {
           "conversionWeight": {
            "$min": [
             1.3,
             {
              "$max": [
               0.2,
               {
                "$divide": [
                 {
                  "$divide": [
                   {
                    "$add": [
                     {
                      "$multiply": [
                       0.03,
                       20
                      ]
                     },
                     "$$credited"
                    ]
                   },
                   {
                    "$add": [
                     20,
                     "$$attempted"
                    ]
                   }
                  ]
                 },
                 0.03
                ]
               }
              ]
             }
            ]
           },
           "sendQualityWeight": {
            "$min": [
             1.1,
             {
              "$max": [
               0.5,
               {
                "$divide": [
                 {
                  "$divide": [
                   {
                    "$add": [
                     {
                      "$multiply": [
                       0.82,
                       20
                      ]
                     },
                     "$$survived"
                    ]
                   },
                   {
                    "$add": [
                     20,
                     "$$attempted"
                    ]
                   }
                  ]
                 },
                 0.82
                ]
               }
              ]
             }
            ]
           }
          },
          "in": {
           "$multiply": [
            {
             "$rand": {}
            },
            "$$conversionWeight",
            "$$sendQualityWeight"
           ]
          }
         }
        }
       }
      }
     }
    }
   }
  },
  {
   "$project": {
    "_ci": 0,
    "_ciExcluded": 0
   }
  }
 ],
 "priorPipeline": [
  {
   "$group": {
    "_id": null,
    "totalCredited": {
     "$sum": {
      "$convert": {
       "input": "$DMs.credited",
       "to": "double",
       "onError": 0,
       "onNull": 0
      }
     }
    },
    "totalAttempted": {
     "$sum": {
      "$convert": {
       "input": "$outcomes.attempted",
       "to": "double",
       "onError": 0,
       "onNull": 0
      }
     }
    },
    "totalSurvived": {
     "$sum": {
      "$convert": {
       "input": "$outcomes.survived",
       "to": "double",
       "onError": 0,
       "onNull": 0
      }
     }
    }
   }
  }
 ]
}